NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakak (Phase 156 step 2, docs/kakak-setup.md). Server-only: never NEXT_PUBLIC_.
# Off unless KAKAK_ENABLED is exactly "true" and a key is set.
KAKAK_ENABLED=
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5; low (default), medium or high.
KAKAK_MODEL=
KAKAK_EFFORT=
