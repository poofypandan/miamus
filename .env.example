NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakak (Phase 156 step 2, docs/kakak-setup.md). Server-only: never NEXT_PUBLIC_.
# Off unless KAKAK_ENABLED is exactly "true" and a key is set.
KAKAK_ENABLED=
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5; low (default), medium or high.
KAKAK_MODEL=
KAKAK_EFFORT=
# Practice mode: scripted answers, no AI, no tokens, no key needed. Ignored on production.
KAKAK_PRACTICE=
# Talk to Kakak (voice beta): the phone's own speech recognition and voice, no key.
# On by default wherever Kakak is; set to "false" to hide the mic and speaker.
NEXT_PUBLIC_KAKAK_VOICE=
# Kakak's own voice for Read replies aloud (ElevenLabs). Server-only. Off, and the
# phone reads aloud itself, unless both the key and the voice id are set.
# KAKAK_VOICE_ID is the voice's id in ElevenLabs (her voice: "Lyly", added to My Voices).
ELEVENLABS_API_KEY=
KAKAK_VOICE_ID=
# Optional: eleven_v4 (default); characters a household may hear per day, 3000 (default), 0 = off.
KAKAK_VOICE_MODEL=
KAKAK_VOICE_DAILY_CHARS=
