# Photo restore: copy to ~/.miamus-photo-restore.env (outside the repository),
# fill in, then: chmod 600 ~/.miamus-photo-restore.env
# Never commit the filled-in file, never paste it into a chat. The script
# prints counts only.
#
#   set -a; source ~/.miamus-photo-restore.env; set +a
#   npx tsx scripts/photo-backup/restore.ts --household <id> --include-deleted
#
# The backup bucket (AWS S3, ap-southeast-1). For the staging drill use the
# staging backup bucket instead.
BACKUP_S3_BUCKET="miamus-photo-backup-production"
BACKUP_S3_REGION="ap-southeast-1"
# The restore key: IAM user miamus-photo-restore (list and read only). Kept in
# the password manager, not in GitHub.
BACKUP_S3_RESTORE_ACCESS_KEY_ID="AKIA..."
BACKUP_S3_RESTORE_SECRET_ACCESS_KEY="..."
#
# Where the photos go back: the Supabase project (staging for the drill).
# Project Settings -> API Keys -> a secret key (sb_secret_...).
TARGET_SUPABASE_URL="https://<project ref>.supabase.co"
TARGET_SUPABASE_SECRET_KEY="sb_secret_..."
