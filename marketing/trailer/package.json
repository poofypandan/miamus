{
  "name": "miamus-trailer",
  "version": "0.4.0",
  "private": true,
  "description": "The Miamus trailer: the app's real screens from its test stub, a drawn world, voice and music made locally, composed in Remotion. Separate from the app; adds no dependency to it.",
  "scripts": {
    "capture": "cd ../.. && npx playwright test -c marketing/trailer/capture/capture.config.ts",
    "sound": "./audio/sound.sh",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "frames": "node scripts/frames.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/mali": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@remotion/cli": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
